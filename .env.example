# Openroute service API key (https://openrouteservice.org/)
OPENROUTESERVICE_API_KEY="Replace this string with your Openroute API key"

# NGSI-LD endpoint of the provider: the data space connector (Level 2) or a broker (Level 1 / local)
# CitCom: https://apisix-townhall-vlc.citcom-vrain-dataspace.eu/lepus
NGSI_LD_URL="http://localhost:1026"
# NGSILD_TENANT=""
# WASTE_CONTAINER_TYPE="WasteContainer"
# WASTE_CONTAINER_LIMIT="100"

# Level 2 (data space): set DS_ISSUER_URL to get a data space token for every request.
# See https://github.com/CitComAI-Hub/ds-consumer-auth
# DS_ISSUER_URL="https://keycloak-vrain.citcom-vrain-dataspace.eu/realms/provider"
# DS_USERNAME="machine1"
# DS_PASSWORD=""
# DS_VERIFIER_URL="https://verifier-townhall-vlc.citcom-vrain-dataspace.eu/services/machine-id"
# DS_SCOPE="operator1"
